# ==========================================
# GITIGNORE FOR RECIPE FOOD REPOSITORY
# ==========================================

# --- DEPENDENCIES ---
node_modules/
backend/node_modules/
frontend/node_modules/
package-lock.json.backup

# --- ENVIRONMENT VARIABLES & SECRETS ---
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# --- BUILD OUTPUTS ---
dist/
frontend/dist/
dist-ssr/
build/
*.local

# --- MS OFFICE TEMPORARY & LOCK FILES ---
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp

# --- LOGS & DEBUGGERS ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OPERATING SYSTEM FILES ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --- IDE & EDITORS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*~
